# Copy this file to .env.local and fill only the values your app needs.
# The app boots and functions immediately with zero configuration.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Database (PostgreSQL via Neon, Supabase, or local Docker)
DATABASE_URL=postgresql://postgres:password@localhost:5432/next_agent_db

# Optional Better Auth (Generate secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth Providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Billing & Monetization (polar or stripe)
PAYMENT_PROVIDER=polar

# Polar (Merchant of Record)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional Supabase integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Sanity integration
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
